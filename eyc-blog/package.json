{
  "name": "eyc-blog",
  "version": "0.0.1",
  "description": "A starter for TinaCMS with Hugo",
  "main": "index.js",
  "scripts": {
    "dev": "tinacms dev -c \"hugo server -D\"",
    "dev:server": "tinacms dev -c 'hugo server -D -p 1313'",
    "prod:server": "tinacms dev -c 'hugo server --environment production -p 1313'",
    "build": "tinacms build && hugo",
    "build-local": "tinacms build --local --skip-indexing --skip-cloud-checks && hugo",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:hugo": "hugo --destination ../docs",
    "deploy": "npm run build:hugo && git add --force ../docs && git commit -m 'Update blog' && git push --force origin primary:public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinalabs/vanilla-hugo.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/tinalabs/vanilla-hugo/issues"
  },
  "homepage": "https://github.com/tinalabs/vanilla-hugo#readme",
  "dependencies": {
    "@tinacms/auth": "^1.1.0",
    "@tinacms/cli": "^1.10.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tinacms": "^2.8.2"
  }
}